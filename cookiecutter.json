{
    "project_name": "Data Science Project",
    "project_description": "A short description of the project.",
    "repo_name": "{{ cookiecutter.project_name.lower().replace(' ', '-') }}",
    "repo_url": "URL to repository",
    "package_manager": ["uv", "conda"],
    "env_name": "{{ cookiecutter.project_name.lower().replace(' ', '-') + '-env' }}",
    "install_jupyter": ["yes", "no"],
    "linter_name": ["ruff", "pylint"],
    "cicd_configuration": ["none", "GitHub", "Azure DevOps", "GitLab"],
    "_versions": {
        "python": "3.13",
        "jupyter": "1.0.0",
        "pylint": "3.2.5",
        "ruff": "0.6.7",
        "pre_commit": "3.7.1",
        "nbqa": "1.8.5",
        "black": "24.4.2"
    },
    "_conventions": {
        "line_length": 100
    }
}
